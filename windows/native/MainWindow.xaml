<Window x:Class="Luma.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Luma Launcher" Width="680" SizeToContent="Height" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" PreviewKeyDown="OnKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#20222b"/><SolidColorBrush x:Key="SurfaceBrush" Color="#282b36"/><SolidColorBrush x:Key="TextBrush" Color="#edf0f8"/><SolidColorBrush x:Key="MutedBrush" Color="#9ba4b8"/><SolidColorBrush x:Key="BorderBrush" Color="#4a5062"/><SolidColorBrush x:Key="SelectedBrush" Color="#333c58"/><SolidColorBrush x:Key="AccentBrush" Color="#8da9ff"/>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="9" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8,8,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,14,0"/><Grid Grid.Column="1"><TextBox x:Name="Query" FontSize="19" Padding="0,8" Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" BorderThickness="0" MaxLength="512" VerticalContentAlignment="Center" TextChanged="QueryChanged"/><TextBlock x:Name="Placeholder" Text="Search applications..." FontSize="19" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid><Button x:Name="SettingsButton" Grid.Column="2" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTip="Settings (Ctrl+,)" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="10,8" Click="SettingsClicked"/><Button Grid.Column="3" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" ToolTip="Quit Luma" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="10,8" Margin="6,0,0,0" Click="QuitClicked"/></Grid></Border>
      <ListBox x:Name="Results" Grid.Row="1" Margin="0,8" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="ResultClicked"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Margin="0,0,12,0" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Icon}" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,12,12,4"><TextBlock x:Name="Status" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Text="↑↓ Navigate    Enter Open    Esc Close    Ctrl+D Pin"/></Border>
    </Grid>
  </Border>
</Window>
